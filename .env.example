# GEOloopOS Identity Engine · 模型源配置
# 复制本文件为 .env，填入真实 Key；.env 不进 git

# DeepSeek API Key（https://platform.deepseek.com 获取，OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxx

# 豆包（火山方舟）API Key —— 在 https://console.volcengine.com/ark 开通「方舟」后创建
# 控制台右上角「API Key 管理」→ 创建，填入下面
ARK_API_KEY=

# OpenRouter API Key —— Ox Alpha 等模型源（https://openrouter.ai/settings/keys 创建，OpenAI 兼容）
OPENROUTER_API_KEY=sk-or-v1-xxxx

# 可选：Ox Alpha 若更名/换模型，用此覆盖（默认 stealth/ox-alpha）
# OPENROUTER_MODEL=stealth/ox-alpha

# 可选：指定豆包模型名或方舟推理接入点 ID（ep-xxx），默认 doubao-seed-2-0-pro-260215
# DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# 可选：端口与限流（生产部署可调整）
# PORT=8788
# RATE_PER_MIN=8
# RATE_PER_DAY=80
# MAX_CONCURRENT=3
