# GEOloopOS 私有部署配置模板
# 复制为 .env 后填写。至少填 1 个 LLM key 才能跑检测。

# ========== 必填：AI 检测源（至少 1 个） ==========
# DeepSeek（推荐，国内可用）：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 豆包 Ark（火山引擎，可选）
ARK_API_KEY=

# Perplexity（可选，返回 citations 真引用，需国际网络）
PPLX_API_KEY=

# ========== 控制台付费门禁 ==========
# 激活码管理口令（由服务方交付时提供，勿外泄）
LICENSE_ADMIN_KEY=

# ========== 可选调优 ==========
# 每 IP 限流（次/分钟、次/天）
RATE_PER_MIN=8
RATE_PER_DAY=80
# 全局并发检测上限
MAX_CONCURRENT=3
# 来访观测站点白名单（逗号分隔，留空则默认）
OBSERVE_SITES=
